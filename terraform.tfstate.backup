                  "finalizers": null,
                  "generateName": null,
                  "generation": null,
                  "labels": {
                    "release": "kube-prometheus-stack"
                  },
                  "managedFields": null,
                  "name": "homelab-starter-alerts",
                  "namespace": "monitoring",
                  "ownerReferences": null,
                  "resourceVersion": null,
                  "selfLink": null,
                  "uid": null
                },
                "spec": {
                  "groups": [
                    {
                      "interval": null,
                      "limit": null,
                      "name": "homelab.rules",
                      "partial_response_strategy": null,
                      "rules": [
                        {
                          "alert": "NodeDown",
                          "annotations": {
                            "description": "{{ $labels.instance }} has been unreachable for 5+ minutes.",
                            "summary": "Node {{ $labels.instance }} is down"
                          },
                          "expr": "up{job=\"node-exporter\"} == 0",
                          "for": "5m",
                          "keep_firing_for": null,
                          "labels": {
                            "severity": "critical"
                          },
                          "record": null
                        },
                        {
                          "alert": "PodCrashLooping",
                          "annotations": {
                            "description": "Container {{ $labels.container }} has restarted more than 3 times in 15 minutes.",
                            "summary": "Pod {{ $labels.namespace }}/{{ $labels.pod }} is crash-looping"
                          },
                          "expr": "increase(kube_pod_container_status_restarts_total[15m]) \u003e 3",
                          "for": "5m",
                          "keep_firing_for": null,
                          "labels": {
                            "severity": "warning"
                          },
                          "record": null
                        },
                        {
                          "alert": "HighDiskUsage",
                          "annotations": {
                            "description": "Filesystem {{ $labels.mountpoint }} on {{ $labels.instance }} is over 85% full.",
                            "summary": "Disk usage above 85% on {{ $labels.instance }}"
                          },
                          "expr": "100 - ((node_filesystem_avail_bytes{fstype!=\"tmpfs\"} * 100) / node_filesystem_size_bytes{fstype!=\"tmpfs\"}) \u003e 85",
                          "for": "10m",
                          "keep_firing_for": null,
                          "labels": {
                            "severity": "warning"
                          },
                          "record": null
                        }
                      ]
                    }
                  ]
                }
              },
